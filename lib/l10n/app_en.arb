  "safetyTitle": "Safety information",
  "@safetyTitle": {
    "description": "Title of the safety information screen"
  },
  "safetyIntro": "Corvista is a driving-awareness aid. It does not control your vehicle and cannot replace your own attention, judgement or the vehicle's safety systems.",
  "@safetyIntro": {
    "description": "Safety screen intro"
  },
  "safetyBeforeTitle": "Before you drive",
  "@safetyBeforeTitle": {
    "description": "Safety section heading"
  },
  "safetyBefore1": "Mount your iPhone securely in a legal position that doesn't block your view, airbags or controls.",
  "@safetyBefore1": {
    "description": "Safety bullet"
  },
  "safetyBefore2": "Finish setup, choose a view and set your destination while parked.",
  "@safetyBefore2": {
    "description": "Safety bullet"
  },
  "safetyBefore3": "Connect a charger for longer drives and keep the phone out of direct sunlight where possible.",
  "@safetyBefore3": {
    "description": "Safety bullet"
  },
  "safetyWhileTitle": "While driving",
  "@safetyWhileTitle": {
    "description": "Safety section heading"
  },
  "safetyWhile1": "Keep your eyes on the road. Only use the large on-screen controls when it is safe and legal to do so.",
  "@safetyWhile1": {
    "description": "Safety bullet"
  },
  "safetyWhile2": "Alerts are aids, not warnings you can rely on. Silence never means the road is clear.",
  "@safetyWhile2": {
    "description": "Safety bullet"
  },
  "safetyWhile3": "Follow traffic laws, signals and road signs — not the app — when they disagree.",
  "@safetyWhile3": {
    "description": "Safety bullet"
  },
  "safetyLimitsTitle": "Limitations",
  "@safetyLimitsTitle": {
    "description": "Safety section heading"
  },
  "safetyLimits1": "A single phone camera sees only what is in front of it. Objects outside its view, hidden or very close are not detected.",
  "@safetyLimits1": {
    "description": "Safety bullet"
  },
  "safetyLimits2": "Detections may be missed, late or wrong, especially at night, in rain, fog, glare or with a dirty windshield.",
  "@safetyLimits2": {
    "description": "Safety bullet"
  },
  "safetyLimits3": "Only supported categories are recognised: vehicles, buses, motorcycles, bicycles, people, traffic lights and stop signs. Lane hints in the virtual view are stylised, not detected lanes.",
  "@safetyLimits3": {
    "description": "Safety bullet"
  },
  "safetyLimits4": "Proximity is shown as approximate zones (Very close, Close, Medium, Far), never as measured distances. The parking view is not a parking-sensor replacement.",
  "@safetyLimits4": {
    "description": "Safety bullet"
  },
  "safetyHeatTitle": "Heat and battery",
  "@safetyHeatTitle": {
    "description": "Safety section heading"
  },
  "safetyHeat1": "Continuous camera and AI use warms your iPhone. Corvista lowers the analysis rate when the device gets hot and shows a warning; if iOS overheats, the camera may stop.",
  "@safetyHeat1": {
    "description": "Safety bullet"
  },
  "safetyEmergencyTitle": "Emergency feature",
  "@safetyEmergencyTitle": {
    "description": "Safety section heading"
  },
  "safetyEmergency1": "Possible-impact detection is experimental. It can miss real crashes and can be triggered by other events.",
  "@safetyEmergency1": {
    "description": "Safety bullet"
  },
  "safetyEmergency2": "It never contacts anyone silently: iOS always asks you to confirm a call or message. It is not a substitute for calling emergency services yourself.",
  "@safetyEmergency2": {
    "description": "Safety bullet"
  },
  "privacyTitle": "Privacy",
  "@privacyTitle": {
    "description": "Title of the in-app privacy policy screen"
  },
  "privacyIntro": "Corvista is designed to keep your driving data on your iPhone. There is no Corvista account, and Corvista does not run its own servers.",
  "@privacyIntro": {
    "description": "Privacy intro"
  },
  "privacyCameraTitle": "Camera and AI",
  "@privacyCameraTitle": {
    "description": "Privacy section heading"
  },
  "privacyCamera1": "Object detection, tracking and segmentation run entirely on your iPhone. Camera frames are never uploaded.",
  "@privacyCamera1": {
    "description": "Privacy bullet"
  },
  "privacyCamera2": "The camera only runs while Corvista is open on screen. It pauses when the app goes to the background — there is no hidden background recording.",
  "@privacyCamera2": {
    "description": "Privacy bullet"
  },
  "privacyRecordingsTitle": "Recordings",
  "@privacyRecordingsTitle": {
    "description": "Privacy section heading"
  },
  "privacyRecordings1": "The rolling buffer is temporary and overwritten continuously. Footage is only kept when you tap Save Incident or, if you enable it, after a possible impact.",
  "@privacyRecordings1": {
    "description": "Privacy bullet"
  },
  "privacyRecordings2": "Saved clips stay in Corvista's private storage on your iPhone. They leave the device only when you choose Share. Deleting the app deletes them.",
  "@privacyRecordings2": {
    "description": "Privacy bullet"
  },
  "privacyRecordings3": "Audio is recorded only if you turn it on and grant microphone access.",
  "@privacyRecordings3": {
    "description": "Privacy bullet"
  },
  "privacyLocationTitle": "Location",
  "@privacyLocationTitle": {
    "description": "Privacy section heading"
  },
  "privacyLocation1": "Location is used while the app is open for your speed, the map, routes and weather. If \"Save location\" is on, the position at save time is stored with the clip on your device.",
  "@privacyLocation1": {
    "description": "Privacy bullet"
  },
  "privacyNetworkTitle": "Network services",
  "@privacyNetworkTitle": {
    "description": "Privacy section heading"
  },
  "privacyNetwork1": "Apple Maps — map display, place search and routes. Your search text and approximate location are sent to Apple.",
  "@privacyNetwork1": {
    "description": "Privacy bullet"
  },
  "privacyNetwork2": "Apple Weather (WeatherKit) — current and hourly weather for your location.",
  "@privacyNetwork2": {
    "description": "Privacy bullet"
  },
  "privacyNetwork4": "Corvista includes no advertising and no third-party analytics or tracking.",
  "@privacyNetwork4": {
    "description": "Privacy bullet"
  },
  "privacyEmergencyTitle": "Emergency contacts",
  "@privacyEmergencyTitle": {
    "description": "Privacy section heading"
  },
  "privacyEmergency1": "Contacts you choose are stored in the iOS Keychain on this device. Voice cancellation uses on-device speech recognition where available. Calls and messages are only sent after you confirm them in iOS.",
  "@privacyEmergency1": {
    "description": "Privacy bullet"
  },
  "privacyControlsTitle": "Your controls",
