  "driveSaveNotRunning": "பதிவு இன்னும் தொடங்கவில்லை — கேமரா தொடங்கும்வரை காத்திருந்து மீண்டும் முயலுங்கள்.",
  "driveSaveTestFootage": "சோதனைக் காட்சிப்பதிவு பதிவுசெய்யப்படாது. சம்பவச் சேமிப்பு நேரடி கேமராவுடன் செயல்படும்.",
  "driveSaveStorageFull": "உங்கள் iPhone-இல் சேமிப்பிடம் நிரம்பிவிட்டது. இடத்தை விடுவிக்கவும் அல்லது பழைய கிளிப்புகளை நீக்கவும்.",
  "driveSaveIoError": "கிளிப்பைச் சேமிப்பகத்தில் எழுத முடியவில்லை.",
  "driveClips": "கிளிப்புகள்",
  "driveSettings": "அமைப்புகள்",
  "driveViewSwitcher": "ஓட்டும் காட்சிகள்",
  "driveLocationDenied": "இடம் நிறுத்தப்பட்டுள்ளது — வேகம், வரைபடங்கள் மற்றும் வழிகள் கிடைக்கவில்லை.",
  "driveCameraDenied": "கேமரா அணுகல் நிறுத்தப்பட்டுள்ளது — கண்டறிதலும் பதிவும் கிடைக்கவில்லை.",
  "driveRecorderFallback": "ஒலி இன்றி பதிவுசெய்கிறது: மைக்ரோஃபோன் அணுகல் நிறுத்தப்பட்டுள்ளது.",
  "driveRecorderFallbackGeneric": "பதிவு அமைப்புகள் சரிசெய்யப்பட்டன: {reason}",
  "drivePowerThermalSerious": "உங்கள் iPhone சூடாக உள்ளது. குளிர்விக்க AI மெதுவாக இயங்குகிறது — நேரடி வெயிலிலிருந்து விலக்கி, காற்றோட்டத்துக்கு அருகில் வையுங்கள்.",
  "drivePowerThermalCritical": "உங்கள் iPhone மிகவும் சூடாக உள்ளது. குளிரும்வரை AI கண்டறிதல் இடைநிறுத்தப்படும்; முடிந்தால் பதிவு தொடரும்.",
  "drivePowerLowPower": "குறைந்த ஆற்றல் முறை இயக்கத்தில் உள்ளது — AI குறைந்த வீதத்தில் இயங்குகிறது.",
  "drivePowerBatteryLow": "பேட்டரி குறைவாக உள்ளது — ஓட்டும்போது உங்கள் iPhone-ஐ மின்சாரத்தில் இணையுங்கள்.",
  "onboardingTitle1": "ஒவ்வொரு பயணத்திலும் இன்னும் அதிகம் காணுங்கள்.",
  "onboardingBody1": "உங்கள் iPhone-ஐ ஒரு நுண்ணறிவு டாஷ்கேமாகவும் ஓட்டுநர் விழிப்புணர்வுத் துணையாகவும் மாற்றுங்கள்.",
  "onboardingTitle2": "ஒவ்வொரு பிரேமிலும் நுண்ணறிவு.",
  "onboardingBody2": "ஆதரிக்கப்படும் வாகனங்கள், மனிதர்கள், மிதிவண்டிகள் மற்றும் சாலை சமிக்ஞைகளை உங்கள் iPhone-இலேயே அறியுங்கள்.",
  "onboardingTitle3": "ஒரே சாலை. பல கோணங்கள்.",
  "onboardingBody3": "நேரடி கண்டறிதல், மெய்நிகர் ஓட்டுநர் காட்சிகள், ஊடாடும் வரைபடங்கள் மற்றும் நிறுத்தக் காட்சிக்கு இடையே மாறுங்கள்.",
  "onboardingTitle4": "முக்கியமான தருணங்களை வைத்திருங்கள்.",
  "onboardingBody4": "சமீபத்திய டாஷ்கேம் காட்சிப்பதிவைச் சேமித்து, சம்பவங்களை மீளாய்வுசெய்து, பதிவுகளைப் பகிருங்கள்.",
  "onboardingTitle5": "பாதுகாப்பும் தனியுரிமையும்",
  "onboardingSafety1": "Corvista ஓட்டும்போது விழிப்புணர்வுக்கு உதவும் கருவி. சாலையிலிருந்து கண்களை எடுக்காதீர்கள்.",
  "onboardingSafety2": "இது உங்கள் வாகனத்தைக் கட்டுப்படுத்தாது; உங்கள் முடிவெடுக்கும் திறனுக்கும் மாற்றாகாது.",
  "onboardingSafety3": "கண்டறிதல்களும் மதிப்பீடுகளும் துல்லியமற்றதாகவோ தவறவிடப்பட்டதாகவோ இருக்கலாம்.",
  "onboardingSafety4": "கேமரா செயலாக்கம் உங்கள் iPhone-இலேயே நடக்கிறது — வீடியோ பதிவேற்றப்படாது.",
  "onboardingSafety5": "வரைபடங்கள், தேடல், வழிகள் மற்றும் வானிலைக்கு இணைய இணைப்பு தேவை.",
  "onboardingSafety6": "உங்கள் பார்வையைத் தடுக்காதவாறு iPhone-ஐ உறுதியாகப் பொருத்துங்கள்.",
  "onboardingSafety7": "ஓட்டத் தொடங்கும் முன் அமைப்பை முடியுங்கள்.",
  "onboardingAcknowledge": "Corvista ஒரு விழிப்புணர்வு உதவி மட்டுமே என்பதையும், பாதுகாப்பாக ஓட்டுவதற்கு நானே பொறுப்பு என்பதையும் புரிந்துகொள்கிறேன்.",
  "onboardingReadSafety": "முழு பாதுகாப்புத் தகவலைப் படி",
  "onboardingNext": "அடுத்து",
  "onboardingSkip": "தவிர்",
  "onboardingAgree": "தொடரவும்",
  "onboardingPageLabel": "பக்கம் {current} / {total}",
  "permTitle": "அனுமதிகள்",
  "permIntro": "ஒவ்வொரு வசதிக்கும் தேவையானதை மட்டுமே Corvista கேட்கிறது. இவற்றை எப்போது வேண்டுமானாலும் அமைப்புகளில் மாற்றலாம்.",
  "permCameraTitle": "கேமரா",
  "permCameraBody": "கண்டறிதல், டாஷ்கேம் பதிவு மற்றும் நிறுத்தக் காட்சிக்குத் தேவை. வீடியோ உங்கள் iPhone-இலேயே செயலாக்கப்படும்.",
  "permLocationTitle": "இடம்",
  "permLocationBody": "GPS வேகம், வரைபடம், வழிகள், வானிலை மற்றும் சேமித்த கிளிப்புகளுக்கு இடக்குறிப்பிட பயன்படும். ஆப்பைப் பயன்படுத்தும்போது மட்டும்.",
  "permMicTitle": "மைக்ரோஃபோன்",
  "permSpeechNote": "அவசர எச்சரிக்கைகளுக்குக் குரல் மூலம் ரத்துசெய்வதை இயக்கினால் மட்டுமே பேச்சு அறிதல் கோரப்படும்.",
  "permRequired": "தேவை",
  "permOptional": "விருப்பம்",
  "permAllow": "அனுமதி",
  "permGranted": "அனுமதிக்கப்பட்டது",
  "permDenied": "மறுக்கப்பட்டது",
  "permLimited": "வரம்புக்குட்பட்டது",
  "permRestricted": "கட்டுப்படுத்தப்பட்டது",
  "permStart": "ஓட்டத் தொடங்கு",
  "permCameraNeeded": "கேமரா அணுகல் இன்றி தொடரலாம்; ஆனால் அமைப்புகளில் அனுமதிக்கும்வரை கண்டறிதலும் பதிவும் செயல்படாது.",
  "permSetupIntro": "Corvista முழுமையாகச் செயல்பட இவை தேவை. அனைத்தையும் அனுமதி என்பதைத் தட்டினால் iOS ஒவ்வொன்றையும் வரிசையாகக் கேட்கும். இவற்றை எப்போது வேண்டுமானாலும் அமைப்புகளில் மாற்றலாம்.",
  "permCameraLine": "கண்டறிதல், டாஷ்கேம் பதிவு மற்றும் நிறுத்தக் காட்சிக்குத் தேவை. வீடியோ உங்கள் iPhone-இலேயே செயலாக்கப்படும்; ஒருபோதும் பதிவேற்றப்படாது.",
  "permLocationLine": "GPS வேகம், வரைபடம், வழிகள், வானிலை மற்றும் கிளிப்புகள் சேமிக்கப்பட்ட இடம். ஆப்பைப் பயன்படுத்தும்போது மட்டும்.",
  "permMicLine": "சம்பவ கிளிப்புகளில் வாகனத்தின் உள் ஒலி, மற்றும் அவசர எச்சரிக்கையின்போது உங்கள் ரத்துசெய்யும் சொல்லைக் கேட்க.",
  "permSpeechTitle": "பேச்சு அறிதல்",
  "permSpeechLine": "ஆதரிக்கப்படும் இடங்களில் உங்கள் iPhone-இலேயே, அவசரக் கவுண்ட்டவுனின்போது உங்கள் ரத்துசெய்யும் சொல்லை அறியும்.",
  "permAllowAll": "அனைத்தையும் அனுமதி",
  "permAsking": "{permission} அனுமதியைக் கேட்கிறது…",
  "permSomeDenied": "சில அனுமதிகள் நிறுத்தப்பட்டுள்ளன. அந்த வசதிகளைப் பயன்படுத்த அமைப்புகளில் இயக்குங்கள்.",
  "permNotNow": "இப்போது வேண்டாம்",
  "tourLabel": "ஓட்டும் திரை சுற்றுலா",
  "tourProgress": "படி {current} / {total}",
  "tourNext": "அடுத்து",
  "tourBack": "பின்செல்",
  "tourSkip": "சுற்றுலாவைத் தவிர்",
  "tourFinish": "ஓட்டத் தொடங்கு",
  "tourWelcomeTitle": "உங்கள் விரைவு சுற்றுலா",
  "tourWelcomeBody": "ஓட்டும் திரையில் முக்கியமானவற்றை ஒரு நிமிடத்தில் பாருங்கள். வாகனத்தை நிறுத்தியிருக்கும்போது செய்வது சிறந்தது.",
  "tourHudTitle": "உங்கள் கருவிப் பட்டை",
  "tourHudSpeed": "வேகம் GPS-இலிருந்து வருகிறது.",
  "tourHudRec": "REC எத்தனை வினாடிகள் காட்சிப்பதிவு இடையகத்தில் உள்ளது என்பதைக் காட்டும்.",
  "tourHudAi": "AI சிப் மாதிரி, அது காணும் பொருட்களின் எண்ணிக்கை, மற்றும் ஒரு புள்ளியைக் காட்டும்: பச்சை இயங்குகிறது, அம்பர் வரம்புடன், சிவப்பு நின்றுவிட்டது.",
  "tourSaveTitle": "சம்பவத்தைச் சேமி",
  "tourSaveBody": "Corvista கடைசி {seconds} வினாடி வீடியோவின் சுழல் இடையகத்தை வைத்திருக்கும். அது தொடர்ந்து மேலெழுதப்படுவதால், நீங்கள் சேமி என்பதைத் தட்டினால் மட்டுமே எதுவும் வைக்கப்படும். சேமித்த கிளிப்புகள் இந்த iPhone-இல், கிளிப்புகள் பகுதியில் இருக்கும்.",
  "tourRecordTitle": "முழு பயணத்தையும் பதிவுசெய்யுங்கள்",
  "tourRecordBody": "நீங்கள் நிறுத்தும்வரை தொடர்ந்து படமெடுக்க பதிவைத் தட்டுங்கள். நீண்ட பயணங்கள் 5 நிமிடப் பகுதிகளாக கிளிப்புகளில் சேமிக்கப்படும்; பதிவின்போதும் சம்பவத்தைச் சேமி தொடர்ந்து செயல்படும்.",
  "tourViewsTitle": "சாலையைக் காண ஐந்து வழிகள்",
  "tourViewDetection": "ஆதரிக்கப்படும் பொருட்களைச் சுற்றிப் பெட்டிகளுடன் நேரடி கேமரா.",
  "tourViewVirtual": "கண்டறிதல்களிலிருந்து உருவாக்கப்பட்ட எளிய 3D காட்சி.",
  "tourViewMap": "தேடல் மற்றும் வளைவு வாரியான வழிகாட்டலுடன் Apple Maps.",
  "tourViewParking": "கேமராவுடன் மேலிருந்து பார்க்கும் அருகாமைக் காட்சி.",
  "tourViewPerception": "சாலை மற்றும் பொருள் மாஸ்க்குகள்.",
  "tourMapTitle": "தேடலும் வளைவு வாரியான வழிகாட்டலும்",
  "tourMapBody": "வரைபடத்தைத் திறந்து, தேடல் பட்டியைத் தட்டி, சேருமிடத்தைத் தேர்ந்தெடுங்கள். ஒரு வழியைத் தேர்ந்தெடுத்து, வளைவு வாரியான வழிகாட்டலுக்குத் தொடங்கு என்பதைத் தட்டுங்கள். இணைய இணைப்பு தேவை.",
  "tourClipsTitle": "கிளிப்புகள்",
  "tourClipsBody": "சேமித்த சம்பவங்களை மீளாய்வு செய்யலாம், மறுபெயரிடலாம், பகிரலாம் அல்லது நீக்கலாம். நீங்கள் பகிராதவரை கிளிப்புகள் உங்கள் iPhone-இலேயே இருக்கும்.",
  "tourSettingsTitle": "அமைப்புகள்",
  "tourSettingsBody": "குரல் எச்சரிக்கைகளையும் அவற்றின் உணர்திறனையும், பதிவு தரத்தையும் இடையக நீளத்தையும் சரிசெய்யுங்கள்; அவசரநிலை முறையை அமையுங்கள்: ரத்துசெய்யும் கவுண்ட்டவுனுடன் கூடிய சோதனை நிலை மோதல் எச்சரிக்கை.",
  "tourSafetyTitle": "ஓட்டுவதற்கு முன்",
  "tourSafety1": "உங்கள் பார்வையைத் தடுக்காத இடத்தில் iPhone-ஐ உறுதியாகப் பொருத்துங்கள்.",
  "tourSafety2": "ஓட்டும்போது ஆப்புடன் தொடர்புகொள்ளாதீர்கள். வாகனத்தை நிறுத்தியிருக்கும்போது அமையுங்கள்.",
  "tourSafety3": "கண்டறிதல்களும் மண்டலங்களும் மதிப்பீடுகளே. அவை தவறாகவோ தவறவிடப்பட்டதாகவோ இருக்கலாம்.",
  "tourSafety4": "பாதுகாப்பாக ஓட்டுவதற்கு நீங்களே பொறுப்பு.",
  "helpTakeTour": "சுற்றுலா செல்",
